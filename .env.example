# Jarvis 环境配置：cp .env.example .env（禁提交真 token）。
# 账号只有一套：控制台用户名 + 密码 + 共享令牌，三者同时匹配才允许登录。

# --- 控制台账号（单用户共用）---
# 控制台登录用户名。
JARVIS_ADMIN_USER=admin
# 控制台登录密码（登录三元组之一）。
JARVIS_ADMIN_PASSWORD=change-me
# 共享令牌：登录三元组之一，同时是 quant /admin 的 Bearer、对 mcp 的回源 token、
# mcp 对客 Key 缺省也回落到它——全栈只需记这一个 token。
JARVIS_STATIC_AUTH_TOKEN=change-me

# --- 行情源（tushare，short 专线）---
# 只用 short：short 走专线地址，长 token 逻辑保留在代码但本部署停用。
TUSHARE_TOKEN_TYPE=short
# short token（当前唯一生效的行情 token）。
SHORT_TUSHARE_TOKEN=
# LONG 已停用：切回 long 时取消注释并把上面 TYPE 改回 long。
# LONG_TUSHARE_TOKEN=

# --- 量化后端（:8000，独占 data/quant.db）---
QUANT_PORT=8000
QUANT_ENABLE_ETL_WORKER=true
QUANT_ENABLE_SCHEDULER=true
QUANT_LOG_LEVEL=info

# --- 只读代理 MCP（:8081，无库，只调量化后端）---
MCP_PORT=8081
# 对客 Key 缺省回落到上面的共享令牌；如需独立对客 key，取消下一行注释。
# JARVIS_MCP_API_KEY=
JARVIS_REQUEST_TIMEOUT=20

# --- 前端（vite dev :8080，反代 /admin→8000、/mcp→8081）---
FRONTEND_PORT=8080

# 可选API地址；显式设置时采用通用限速/逐证券财务流程，凭据仍按TOKEN_TYPE选择。
# TUSHARE_API_URL=https://api.tushare.pro
